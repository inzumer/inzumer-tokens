{
  "name": "@inzumer/tokens",
  "version": "1.2.1",
  "private": false,
  "description": "Design tokens, theming, and Tailwind preset for the Inzumer design system",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/inzumer-tokens#readme",
  "bugs": {
    "url": "https://github.com/inzumer/inzumer-tokens/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/inzumer-tokens.git"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tailwindcss",
    "theming",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.ts",
      "import": "./dist/tailwind/preset.js",
      "default": "./dist/tailwind/preset.js"
    },
    "./css/reset": "./dist/css/reset.css",
    "./css/variables": "./dist/css/variables.css",
    "./css/typography": "./dist/css/typography.css",
    "./css/scrollbar": "./dist/css/scrollbar.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "node -e \"require('fs').cpSync('src/css','dist/css',{recursive:true})\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "peerDependencies": {
    "react": ">=18 || ^19",
    "react-dom": ">=18 || ^19"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@inzumer/eslint": "^1.1.0",
    "@inzumer/prettier": "github:inzumer/inzumer-prettier#87763a515f7b470b73c172f8e7c8ff7e7ac94365",
    "@inzumer/tsconfig": "github:inzumer/inzumer-tsconfig#70691fbdfedbc9dd44a327f629177b3370c03260",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1"
    }
  }
}
