{
  "extends": "@inzumer/tsconfig/react-library",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@themes/*": ["./src/themes/*"],
      "@tokens/*": ["./src/tokens/*"],
      "@utils/*": ["./src/utils/*"],
      "@theme-types/*": ["./src/types/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
